from pathlib import Path

from src.aia_coder.workflow import process_instruction


def test_process_instruction_writes_qa_file(tmp_path: Path) -> None:
    instruction = tmp_path / "feature.md"
    qa_file = tmp_path / "qa" / "feature_qa.md"
    instruction.write_text("Implement feature", encoding="utf-8")

    process_instruction(instruction, qa_file)

    assert qa_file.exists()
